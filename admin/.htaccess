# Admin par mot de passe : pas de liste de fichiers, et l'en-tête Authorization doit arriver jusqu'à api.php.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# L'admin change souvent : le navigateur redemande toujours ses fichiers (sinon Safari garde d'anciennes versions)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|yml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
